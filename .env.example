# ============================================================================
#  EXPRESS FINANCE — Variables d'environnement
#  Copiez ce fichier en `.env.local` puis renseignez les valeurs réelles.
#  `.env.local` est ignoré par Git : aucun secret ne doit être committé.
# ============================================================================

# ---------------------------------------------------------------------------
# 1. URL publique du site (utilisée pour le SEO, les canonicals, le sitemap,
#    les images Open Graph et la validation d'origine des formulaires).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# 2. Supabase — clés PUBLIQUES (exposées au navigateur, c'est normal et sûr :
#    elles sont protégées par les politiques Row Level Security).
#    Tableau de bord Supabase > Project Settings > API
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---------------------------------------------------------------------------
# 3. Supabase — clé SERVICE ROLE (SECRET ABSOLU).
#    ⚠️ Cette clé contourne la Row Level Security.
#    ⚠️ NE JAMAIS la préfixer par NEXT_PUBLIC_.
#    ⚠️ NE JAMAIS l'importer dans un composant client.
#    Utilisée uniquement côté serveur (route handlers / server actions).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=""

# ---------------------------------------------------------------------------
# 3b. Secret de signature des formulaires (jeton anti-robot) et de hachage
#     des adresses IP. Générer avec : openssl rand -hex 32
#     À défaut, la clé service-role est utilisée comme secret dérivé.
# ---------------------------------------------------------------------------
FORM_SECRET=""

# ---------------------------------------------------------------------------
# 4. Anti-spam (optionnel mais recommandé en production).
#    Cloudflare Turnstile — https://dash.cloudflare.com/?to=/:account/turnstile
#    Si ces variables sont vides, la protection Turnstile est désactivée et
#    seules les protections internes (honeypot, time-trap, rate limiting,
#    déduplication) restent actives.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# ---------------------------------------------------------------------------
# 5. Notifications e-mail (optionnel).
#    Adresse interne recevant les alertes de nouvelle demande.
#    Le transport e-mail n'est pas encore branché : voir docs/CONFIGURATION.md
# ---------------------------------------------------------------------------
NOTIFICATIONS_EMAIL_TO="financeexpress258@gmail.com"
# Expéditeur vérifié dans Resend, ex. "Express Finance <notifications@votre-domaine.com>"
NOTIFICATIONS_EMAIL_FROM=""
RESEND_API_KEY=""

# ---------------------------------------------------------------------------
# 6. Envoi SMTP (formulaire de contact → e-mail de l'administrateur).
#    Hostinger : SMTP_HOST="smtp.hostinger.com", port 465, identifiant = adresse
#    de la boîte pro, SMTP_PASS = mot de passe de la boîte.
#    Gmail : smtp.gmail.com + « mot de passe d'application » (validation en 2 étapes).
#    Si SMTP n'est pas renseigné, RESEND_API_KEY est utilisé à la place.
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
